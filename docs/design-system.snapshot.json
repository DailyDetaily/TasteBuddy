{
  "version": "2026-04-20",
  "purpose": "Fast machine-readable snapshot for AI agents that need to understand the Taste Buddy design system before making UI changes.",
  "source_of_truth": [
    {
      "priority": 1,
      "label": "product_experience",
      "path": "src/guidelines/TASTE_BUDDY_PRODUCT_EXPERIENCE_GUIDELINES.md",
      "role": "Top-level product and UX direction"
    },
    {
      "priority": 2,
      "label": "design_system_doc",
      "path": "DESIGN.md",
      "role": "Visual system explanation, usage rules, and rationale"
    },
    {
      "priority": 3,
      "label": "typed_tokens",
      "path": "src/constants/designTokens.ts",
      "role": "Typed token source of truth"
    },
    {
      "priority": 4,
      "label": "css_tokens",
      "path": "src/styles/design-system.css",
      "role": "CSS variable mirror of app tokens"
    },
    {
      "priority": 5,
      "label": "inventory",
      "path": "src/components/design-system/inventory.ts",
      "role": "Preview inventory, audit notes, and token groupings"
    },
    {
      "priority": 6,
      "label": "component_specs",
      "path": "src/components/design-system/componentStyleSpecs.ts",
      "role": "Representative component style snapshots"
    }
  ],
  "read_order": [
    "docs/AI_DESIGN_SYSTEM.md",
    "src/guidelines/TASTE_BUDDY_PRODUCT_EXPERIENCE_GUIDELINES.md",
    "DESIGN.md",
    "src/constants/designTokens.ts",
    "src/styles/design-system.css",
    "src/components/design-system/inventory.ts"
  ],
  "mental_model": {
    "product_positioning": "Premium dining personalization service that translates palate data into chef-usable guidance.",
    "color_layers": [
      "neutral_system",
      "taste_palette",
      "warm_hospitality_layer"
    ],
    "default_start_point": "neutral_system",
    "mobile_first": true,
    "max_product_font_px": 18
  },
  "terminology": {
    "bg": {
      "meaning": "Stronger taste fill",
      "preferred_usage": [
        "quick_stat",
        "calibration_highlight",
        "measurement_emphasis"
      ]
    },
    "tintSoft": {
      "meaning": "Soft taste tint for inline pills and lightweight meta chips",
      "preferred_usage": [
        "taste_chip",
        "calibration_meta_chip"
      ]
    },
    "tintSoftBorder": {
      "meaning": "Border token paired with tintSoft surfaces"
    },
    "tintSurface": {
      "meaning": "Soft taste card background",
      "preferred_usage": [
        "chef_matching_card",
        "detail_analysis_card"
      ]
    },
    "tintSurfaceText": {
      "meaning": "Primary text on tintSurface"
    },
    "tintSurfaceSubText": {
      "meaning": "Secondary text on tintSurface"
    },
    "main": {
      "meaning": "Taste signal color for value, node, chip, chart, and semantic emphasis"
    },
    "ringBaseColor": {
      "meaning": "Measurement loop implementation token",
      "note": "Do not prefer this for new card semantics when tintSurface exists."
    }
  },
  "core_tokens": {
    "layout": {
      "pageGutter": "20px",
      "sectionGap": "20px",
      "cardStackGap": "12px",
      "primaryButtonHeight": "48px",
      "topAppBarHeight": "56px",
      "screenMaxWidth": "1440px"
    },
    "radius": {
      "badge": "6px",
      "control": "10px",
      "insetSupport": [
        "12px",
        "14px"
      ],
      "card": "20px",
      "pill": "9999px"
    },
    "typography": {
      "fontFamily": "Pretendard",
      "display": "18px",
      "heading": "18px",
      "body": "14px",
      "caption": "12px",
      "micro": [
        "10px",
        "11px"
      ]
    },
    "surfaces": {
      "page": "#F3F3F3",
      "focus": "#FFFFFF",
      "base": "#FFFFFF",
      "card": "#FFFFFF",
      "muted": "#F7F7F7",
      "elevated": "#FCFCFC",
      "overlay": "rgba(255, 255, 255, 0.8)"
    },
    "state": {
      "success": "#2F8F5B",
      "successSoft": "#E6F4EC",
      "warning": "#A8661A",
      "warningSoft": "#FFF1DE",
      "destructive": "#D4183D"
    }
  },
  "taste_palette": {
    "sweet": {
      "label": "단맛",
      "main": "#FF9900",
      "bg": "#FFD699",
      "tintSoft": "rgba(255, 153, 0, 0.05)",
      "tintSoftBorder": "rgba(255, 153, 0, 0.18)",
      "tintSurface": "#FFEBCC",
      "tintSurfaceText": "#6F4609",
      "tintSurfaceSubText": "#896735"
    },
    "sour": {
      "label": "신맛",
      "main": "#FBC02D",
      "bg": "#FFEF99",
      "tintSoft": "rgba(251, 192, 45, 0.05)",
      "tintSoftBorder": "rgba(251, 192, 45, 0.18)",
      "tintSurface": "#FFF7CC",
      "tintSurfaceText": "#6F5F09",
      "tintSurfaceSubText": "#897C35"
    },
    "bitter": {
      "label": "쓴맛",
      "main": "#95C900",
      "bg": "#E0EBB4",
      "tintSoft": "rgba(149, 201, 0, 0.05)",
      "tintSoftBorder": "rgba(149, 201, 0, 0.18)",
      "tintSurface": "#EAF4CC",
      "tintSurfaceText": "#505B24",
      "tintSurfaceSubText": "#70794B"
    },
    "salty": {
      "label": "짠맛",
      "main": "#7299FF",
      "bg": "#C6D6FF",
      "tintSoft": "rgba(114, 153, 255, 0.05)",
      "tintSoftBorder": "rgba(114, 153, 255, 0.18)",
      "tintSurface": "#E3EBFF",
      "tintSurfaceText": "#36466F",
      "tintSurfaceSubText": "#5A6789"
    },
    "umami": {
      "label": "감칠맛",
      "main": "#B372B4",
      "bg": "#E1C7E1",
      "tintSoft": "rgba(179, 114, 180, 0.05)",
      "tintSoftBorder": "rgba(179, 114, 180, 0.18)",
      "tintSurface": "#F0E3F0",
      "tintSurfaceText": "#513751",
      "tintSurfaceSubText": "#705B70"
    },
    "fat": {
      "label": "지방맛",
      "main": "#95867A",
      "bg": "#D5CFCA",
      "tintSoft": "rgba(149, 134, 122, 0.05)",
      "tintSoftBorder": "rgba(149, 134, 122, 0.18)",
      "tintSurface": "#EAE7E4",
      "tintSurfaceText": "#453F3A",
      "tintSurfaceSubText": "#66625D"
    }
  },
  "component_recipes": [
    {
      "id": "chef_matching_card",
      "source": "src/imports/Home.tsx",
      "usage": "Taste-context chef recommendation card",
      "recipe": {
        "background": "getTasteTintSurface(taste)",
        "border": "getTasteTint(taste, 0.18)",
        "titleColor": "getTasteTintSurfaceText(taste)",
        "metaColor": "getTasteTintSurfaceSubText(taste)",
        "matchColor": "getTasteTintSurfaceText(taste)",
        "radius": "20px",
        "padding": "12px",
        "size": "132px x 132px"
      }
    },
    {
      "id": "detail_analysis_card",
      "source": "src/pages/AnalysisPage.tsx",
      "usage": "Taste detail analysis summary card",
      "recipe": {
        "background": "getTasteTintSurface(taste)",
        "border": "getTasteTint(taste, 0.18)",
        "titleColorVar": "--tb-taste-{tasteId}-tint-surface-text",
        "summaryColorVar": "--tb-taste-{tasteId}-tint-surface-sub-text",
        "radius": "20px",
        "padding": "12px",
        "size": "132px x 132px"
      }
    },
    {
      "id": "chip",
      "source": "src/components/system/Chip.tsx",
      "usage": "General product chip for neutral and semantic inline labels",
      "recipe": {
        "sizeSet": [
          "xs",
          "sm",
          "md"
        ],
        "variantSet": [
          "soft",
          "outline",
          "solid",
          "text"
        ],
        "toneSet": [
          "neutral",
          "success",
          "warning",
          "accent"
        ],
        "sizeRecipe": {
          "xs": "font 10px / icon 12px / px 8 / py 4 / gap 4",
          "sm": "font 11px / icon 12px / px 10 / py 6 / gap 6",
          "md": "font 12px / icon 14px / px 12 / py 8 / gap 8"
        },
        "neutralSoft": "surface-muted / border-default / text-muted",
        "backgroundTokenOverride": "backgroundColorToken",
        "shape": "9999px pill",
        "composition": "asChild"
      }
    },
    {
      "id": "taste_chip",
      "source": "src/components/system/TasteChip.tsx",
      "usage": "Small taste tag",
      "recipe": {
        "border": "taste.palette.tintSoftBorder",
        "background": "taste.palette.tintSoft",
        "labelColor": "var(--tb-color-text-primary)",
        "valueColor": "getTasteColor(taste)",
        "radius": "9999px"
      }
    },
    {
      "id": "flow_step_cta",
      "source": "src/components/system/FlowStepCta.tsx",
      "usage": "Shared onboarding and taste measurement step footer",
      "recipe": {
        "layout": "relative flex min-h-[140px] w-full flex-col items-center justify-end px-5",
        "indicatorSpacing": "mb-8",
        "buttonSpacing": "mb-8",
        "measurementVariant": "active indicator uses taste palette.main while inactive dots stay neutral gray"
      }
    },
    {
      "id": "section_card",
      "source": "src/components/SectionCard.tsx",
      "usage": "Default reusable card shell",
      "recipe": {
        "background": "surface-card",
        "radius": "20px",
        "padding": "12px",
        "hoverTranslateY": "-4px"
      }
    }
  ],
  "hard_rules": [
    "Do not exceed 18px font size in product UI.",
    "Do not use taste colors for long body copy.",
    "Do not strongly present all six tastes inside one dense block.",
    "Start default UI states from neutral, success, or warning before taste tokens; reserve destructive for danger actions.",
    "Use taste palette only when taste meaning is the point.",
    "If a reusable visual pattern is added, reflect it in the design system preview."
  ],
  "anti_patterns": [
    "generic_booking_app_layout",
    "lab_like_measurement_ui",
    "purple_startup_gradient",
    "decorative_chart_without_interpretation",
    "giant_display_typography",
    "new_card_using_ringBaseColor_as_primary_semantic_token"
  ],
  "sync_contract": {
    "must_update_together_when_tokens_change": [
      "DESIGN.md",
      "src/constants/designTokens.ts",
      "src/styles/design-system.css",
      "src/components/design-system/inventory.ts"
    ],
    "sometimes_update": [
      "src/components/design-system/componentStyleSpecs.ts",
      "docs/AI_DESIGN_SYSTEM.md",
      "docs/design-system.snapshot.json"
    ]
  }
}
