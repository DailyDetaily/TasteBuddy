{
  "schema_version": "tba-menu-auto-tagging-design-v0.1",
  "status": "authored_expected_outputs_not_classifier_results",
  "example_assumptions": [
    "각 정상 사례는 해당 음식 이름·수식 관계의 규칙이 검토된 배포 사전에 등록됐다는 조건의 기대 출력이다. 현재 초안 규칙이 승인·배포됐다는 뜻이 아니다.",
    "별도 명시가 없으면 이름 식별이 명확하고 근거 충돌과 사용자 수정이 없는 첫 분류를 가정한다.",
    "메뉴·대상 범위의 해석 정확도를 실행 검증한 자료가 아니다."
  ],
  "selection_policy": {
    "enabled_in_design": true,
    "deployed": false,
    "default_when_menu_known": "auto_select_eligible_tags_and_prepare_map",
    "separate_confirmation_step": false,
    "saving_confirms_auto_tags": false,
    "selection_modes": [
      "automatic",
      "user_edited",
      "user_empty"
    ],
    "decision_states": [
      "auto_select",
      "suggest",
      "abstain",
      "suppressed_by_user"
    ],
    "origins": [
      "menu_catalog",
      "menu_name_rule",
      "model_inferred",
      "user"
    ],
    "auto_selection_gates": [
      "reviewed_source_or_rule",
      "matched_menu_identity_and_version",
      "valid_taxonomy_ids",
      "supported_target_scope",
      "qualifiers_and_negations_resolved",
      "no_conflicting_evidence",
      "current_input_revision",
      "no_user_override",
      "feedback_not_started"
    ],
    "model_default_decision": "suggest",
    "model_self_reported_confidence_is_gate": false,
    "manual_edit_policy": "preserve_effective_selection_set_for_same_subject; later automatic results are suggestions",
    "explicit_empty_is_valid": true,
    "restore_empty_with_inference": false,
    "same_menu_alias_preserves_user_actions": true,
    "different_menu_subject_reuses_old_actions": false,
    "late_revision_response_applies": false,
    "late_auto_result_repositions_active_map": false,
    "maps_update_after_explicit_user_edit": true,
    "selected_bubbles_survive_reclassification": true,
    "auto_tags_create_sensory_observations": false,
    "auto_tags_update_taste_preferences": false,
    "entry_with_multiple_refinements_selects_all_children": false,
    "fallback": "common_map; recording and saving remain available",
    "design_ref": "./tba-menu-auto-tagging-design.md",
    "examples_ref": "./tba-menu-auto-tagging-examples.json"
  },
  "classification_cases": [
