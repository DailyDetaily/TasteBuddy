{
  "name": "brand-launch",
  "version": "1.0.0",
  "description": "Taste Buddy 30초 브랜드 런칭 영상 · 실제 SwiftUI 화면 자동 갱신",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.521",
    "@remotion/fonts": "4.0.521",
    "@remotion/media": "4.0.521",
    "@remotion/paths": "4.0.521",
    "@remotion/player": "4.0.521",
    "@remotion/transitions": "4.0.521",
    "@remotion/zod-types": "4.0.521",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.521",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.521",
    "@types/react": "19.2.7",
    "@types/react-dom": "~19.2.0",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "studio": "node scripts/dev.mjs",
    "build": "remotion bundle",
    "lint": "eslint src && tsc",
    "native:capture": "node scripts/native-ui.mjs --once",
    "native:watch": "node scripts/native-ui.mjs --watch",
    "native:check": "node scripts/native-ui.mjs --check",
    "test:sync": "node --test scripts/native-ui.test.mjs",
    "sync:brand": "node scripts/sync-brand.mjs",
    "audio:generate": "python3 scripts/generate-score.py",
    "render": "node scripts/render.mjs",
    "test:motion": "node --test scripts/taste-motion.test.mjs",
    "studio:categories": "remotion studio --no-open --port=3110",
    "dev:native": "node scripts/dev.mjs --with-native-captures",
    "sync:feedback": "node scripts/native-feedback-sync.mjs",
    "sync:feedback:watch": "node scripts/native-feedback-sync.mjs --watch",
    "sync:feedback:check": "node scripts/native-feedback-sync.mjs --check",
    "test:feedback-sync": "node --test scripts/native-feedback-sync.test.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
