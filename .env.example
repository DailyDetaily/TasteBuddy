VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Legacy fallback if your dashboard still shows an anon key instead of a publishable key.
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Preferred public media origin for DB media keys such as chefs/jungsik.png.
# Use the Cloudflare R2 custom domain connected to the public media bucket.
VITE_R2_PUBLIC_MEDIA_BASE_URL="https://media.your-domain.com"
# Generic alias if the media origin is not R2-specific.
VITE_PUBLIC_MEDIA_BASE_URL="https://media.your-domain.com"
# Legacy fallback. Used only when no public media base URL is configured.
VITE_SUPABASE_PUBLIC_ASSET_BUCKET="taste-buddy-assets"
# Server-side only. Never prefix secret keys with VITE_.
SUPABASE_SECRET_KEY="your-supabase-secret-key"
# Legacy fallback if your dashboard exposes service_role instead of a secret key.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Anonymous auth is used by default for MVP hydration/persistence.
# Set to "false" if you want to require an existing Supabase session instead.
VITE_SUPABASE_USE_ANONYMOUS_AUTH="true"

# Analytics. Use separate IDs so local/dev traffic never mixes into production reports.
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_CLARITY_PROJECT_ID="your-production-clarity-project-id"
VITE_GA_MEASUREMENT_ID_LOCAL="G-YYYYYYYYYY"
VITE_CLARITY_PROJECT_ID_LOCAL="your-local-clarity-project-id"

# Server-side place index sync. Never prefix these with VITE_.
# Also used by the Supabase Edge Function `kakao-place-lookup`.
KAKAO_REST_API_KEY="your-kakao-rest-api-key"
NAVER_CLIENT_ID="your-naver-client-id"
NAVER_CLIENT_SECRET="your-naver-client-secret"
# Used by the Supabase Edge Function `google-place-enrich` for hours, website, and curation signals.
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
